{
  "name": "@restlessai/cli-feedback",
  "version": "0.1.0",
  "description": "Send a note from any CLI to its API's maintainers on Restless. No framework, no dependencies.",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "install.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "feedback",
    "restless",
    "api"
  ],
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
