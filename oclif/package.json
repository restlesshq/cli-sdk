{
  "name": "@restlessai/oclif-plugin-feedback",
  "version": "0.1.0",
  "description": "Adds a `feedback` command to any oclif CLI, so its users (and their coding agents) can tell your API's maintainers what confused them.",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "oclif": {
    "commands": "./dist/commands"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@restlessai/cli-feedback": "^0.1.0"
  },
  "peerDependencies": {
    "@oclif/core": ">=4"
  },
  "devDependencies": {
    "@oclif/core": "^5.1.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oclif",
    "oclif-plugin",
    "feedback",
    "restless",
    "api"
  ],
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
